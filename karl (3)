CREATE FUNCTION GetTransferredCredits (@part_id INT)
RETURNS DECIMAL(5,1)
AS
BEGIN
    DECLARE @total DECIMAL(5,1);
    
    SELECT @total = SUM(transferred_credits)
    FROM Course_Equivalency
    WHERE part_id = @part_id AND approval_status = 'Approved';
    
    IF @total IS NULL
        SET @total = 0;
        
    RETURN @total;
END;
GO

